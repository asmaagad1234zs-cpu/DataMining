/*
=============================================================
Database and Schema Setup
=============================================================
Purpose:
    Creates a fresh 'DataWarehouse' database. If one already
    exists, it is dropped and rebuilt from scratch. The script
    then adds three schemas: 'bronze', 'silver', and 'gold'.

WARNING:
    If 'DataWarehouse' exists, this script permanently deletes
    it and all of its data. Make sure you have a current backup
    before running it.
=============================================================
*/
USE master;
GO

IF NOT EXISTS (SELECT 1 FROM sys.databases WHERE name = 'DataWarehouse')
    CREATE DATABASE DataWarehouse;
GO

USE DataWarehouse;
GO

IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'bronze')
    EXEC('CREATE SCHEMA bronze');
IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'silver')
    EXEC('CREATE SCHEMA silver');
IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'gold')
    EXEC('CREATE SCHEMA gold');
GO
